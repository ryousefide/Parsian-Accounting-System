  object SQu: TQuery
    DatabaseName = 'ParFro'
    SQL.Strings = (
      
        'SELECT G.Nam GNam, G.Pfee, G.Quant, G.Ptotal, G.Perc, G.No, G.Da' +
        't, I.Nam, I.Prule'
      'FROM Invogood  G'
      '   INNER JOIN Invoice I'
      '   ON  (I.No = G.No) '
      ''
      'Order by G.Dat,G.No')
    Left = 126
    Top = 100
